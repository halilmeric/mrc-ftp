{
  "name": "mrc-ftp",
  "version": "0.6.0",
  "description": "cPanel hostingleri için sade FTP/FTPS/SFTP istemcisi",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "MRCHA",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "basic-ftp": "6.2.6",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "ftp-srv": "4.6.3"
  },
  "build": {
    "appId": "com.mrcha.mrcftp",
    "productName": "MRC FTP",
    "files": [
      "src/**",
      "package.json",
      "!**/*.node",
      "!**/node_modules/cpu-features/**",
      "!**/node_modules/nan/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.developer-tools"
    },
    "npmRebuild": false
  }
}
